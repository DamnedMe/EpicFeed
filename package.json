{
  "name": "epicfeed",
  "private": true,
  "description": "Study Feed: lezioni Epicode trasformate in un feed di schede, quiz e ripasso.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm docs:status:check && turbo run lint typecheck test build",
    "docs:status": "node scripts/docs-status.mjs",
    "docs:status:check": "node scripts/docs-status.mjs --check"
  },
  "devDependencies": {
    "@epicfeed/config": "workspace:*",
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "7.0.2"
  }
}
