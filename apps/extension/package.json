{
  "name": "@epicfeed/extension",
  "version": "0.1.0",
  "private": true,
  "description": "Estensione Chrome (MV3, WXT) che importa in EpicFeed la lezione Epicode aperta.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "vitest run"
  },
  "dependencies": {
    "@epicfeed/ingest": "workspace:*",
    "@epicfeed/shared": "workspace:*",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@epicfeed/config": "workspace:*",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "typescript": "7.0.2",
    "vitest": "5.1.1",
    "wxt": "0.21.5"
  }
}
