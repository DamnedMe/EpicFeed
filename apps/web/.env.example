# Copia in apps/web/.env.local (ignorato da git) e compila. Su Vercel: Settings → Environment Variables.
# URL pubblico del progetto Supabase (Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://nxuysaeevxcncchqjtep.supabase.co
# Chiave pubblicabile (sb_publishable_…), pubblica per costruzione: la protezione è la RLS.
