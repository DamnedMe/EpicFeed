# Stringa del Transaction pooler (porta 6543) con la password del database. SEGRETO.
DATABASE_URL=
# Email ammesse ad accedere, separate da virgole.
ALLOWED_EMAILS=
# ID dell'estensione Chrome (fisso, dalla chiave del manifest).
NEXT_PUBLIC_EXTENSION_ID=bchcghaegcogobjapblaanbpnkpkihdd
