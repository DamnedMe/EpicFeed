{
  "name": "@epicfeed/web",
  "version": "0.0.0",
  "private": true,
  "description": "Web app di Study Feed (Next.js): login, Le mie lezioni, collegamento dell'estensione e API di import.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-pyodide.mjs && next dev",
    "build": "node scripts/copy-pyodide.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node e2e/harness/build.mjs && playwright test -c e2e/playwright.config.ts",
    "perf": "node perf/lighthouse.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.44.0",
    "@epicfeed/access": "workspace:*",
    "@epicfeed/assistant": "workspace:*",
    "@epicfeed/catalog": "workspace:*",
    "@epicfeed/db": "workspace:*",
    "@epicfeed/exam": "workspace:*",
    "@epicfeed/feed": "workspace:*",
    "@epicfeed/ingest": "workspace:*",
    "@epicfeed/review": "workspace:*",
    "@epicfeed/shared": "workspace:*",
    "@epicfeed/ui": "workspace:*",
    "@lezer/highlight": "1.2.5",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "postgres": "4.1.1",
    "pyodide": "314.0.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@epicfeed/config": "workspace:*",
    "@next/eslint-plugin-next": "16.4.6",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "chrome-launcher": "1.2.3",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "lighthouse": "13.5.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
