{
  "name": "@epicfeed/mcp",
  "version": "0.1.6",
  "private": true,
  "description": "Server MCP di EpicFeed per Claude Desktop: genera schede, quiz e concetti delle lezioni importate (M2).",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/bundle.mjs",
    "pack": "node scripts/pack.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@napi-rs/canvas": "1.1.0",
    "@epicfeed/contracts": "workspace:*",
    "@epicfeed/core": "workspace:*",
    "pdfjs-dist": "6.5.438",
    "yauzl": "3.4.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@epicfeed/config": "workspace:*",
    "@types/node": "26.6.6",
    "@types/yauzl": "3.4.0",
    "@vitest/coverage-v8": "5.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
