{
  "name": "@study-feed/core",
  "version": "0.0.0",
  "private": true,
  "description": "Dominio e casi d'uso di Study Feed: TypeScript puro, senza framework né I/O.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@study-feed/config": "workspace:*",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "ts-fsrs": "5.4.2"
  }
}
