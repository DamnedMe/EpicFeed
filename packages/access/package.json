{
  "name": "@epicfeed/access",
  "version": "0.0.0",
  "private": true,
  "description": "Accesso delle app esterne: token di estensione e Claude Desktop, limiti di frequenza.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./infrastructure": {
      "types": "./dist/infrastructure/index.d.ts",
      "default": "./dist/infrastructure/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@epicfeed/db": "workspace:*",
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.6.0",
    "@epicfeed/config": "workspace:*",
    "@types/node": "26.6.10",
    "@vitest/coverage-v8": "5.1.2",
    "eslint": "10.15.0",
    "typescript": "7.0.2",
    "vitest": "5.1.2"
  }
}
