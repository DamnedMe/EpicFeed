{
  "name": "@epicfeed/review",
  "version": "0.0.0",
  "private": true,
  "description": "Ripasso dei concetti: FSRS, sessioni, riepilogo per modulo e sincronizzazione cifrata dei progressi.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./infrastructure": {
      "types": "./dist/infrastructure/index.d.ts",
      "default": "./dist/infrastructure/index.js"
    },
    "./crypto": {
      "types": "./dist/crypto/progress-crypto.d.ts",
      "default": "./dist/crypto/progress-crypto.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@epicfeed/db": "workspace:*",
    "@epicfeed/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "ts-fsrs": "5.4.2",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@epicfeed/config": "workspace:*",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
