{
  "name": "@epicfeed/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Nucleo condiviso di EpicFeed: errori di dominio, id e regole sul testo. TypeScript puro.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@epicfeed/config": "workspace:*",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
